#!/bin/sh
# agent-gate:githooks:1
set -eu

setup='curl -fsSL https://mise.run | sh && echo "$HOME/.local/bin" >> "$GITHUB_PATH" && echo "$HOME/.local/share/mise/shims" >> "$GITHUB_PATH" && "$HOME/.local/bin/mise" trust && "$HOME/.local/bin/mise" install && "$HOME/.local/bin/mise" exec -- bun install --frozen-lockfile'

[ -n "$setup" ] || exit 0
sh -c "$setup"
