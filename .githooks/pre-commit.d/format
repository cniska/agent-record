#!/bin/sh
# agent-gate:format:3
set -eu

command='bun run format'

paths() {
  git "$@" -z | od -An -v -to1 | tr -s ' \n' '\n\n' | awk 'NF { if ($0 == "000") { print path; path = "" } else path = path "\\" $0 }'
}

unescaped() {
  printf "$(printf "$1" $2)"
}

listed() {
  printf '%s\n' "$1" | grep -Fxq -- "$2"
}

shown() {
  unescaped '  %s\\n' "$1" >&2
}

entry() {
  file=$(unescaped '%s/' "$1")
  file=${file%/}
  if [ -f "$file" ]; then
    printf '%s %s\n' "$(git hash-object -- "$file")" "$1"
  else
    printf '%s %s\n' - "$1"
  fi
}

entries() {
  printf '%s\n' "$1" | while IFS= read -r path; do
    [ -z "$path" ] || entry "$path"
  done
}

touched() {
  if listed "$dirty" "$1"; then
    ! listed "$before" "$(entry "$1")"
  else
    listed "$after" "$1"
  fi
}

picked() {
  printf '%s\n' "$1" | while IFS= read -r path; do
    [ -n "$path" ] || continue
    case "$2" in
      partly) listed "$dirty" "$path" || continue ;;
      whole) ! listed "$dirty" "$path" || continue ;;
      unstaged) ! listed "$staged" "$path" || continue ;;
    esac
    ! touched "$path" || printf '%s\n' "$path"
  done
}

run_command() {
  if ! output=$(sh -c "$command" 2>&1); then
    printf 'format: `%s` failed:\n%s\n' "$command" "$output" >&2
    exit 1
  fi
}

if [ "${1:-}" = --run ]; then
  root=$(git rev-parse --show-toplevel)
  cd "$root"
  exec sh -c "$command"
fi

[ ! -f "$(git rev-parse --git-path MERGE_HEAD)" ] || exit 0

staged=$(paths diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0
dirty=$(paths diff --name-only)
before=$(entries "$dirty")

run_command

after=$(paths diff --name-only)
partly=$(picked "$staged" partly)
if [ -n "$partly" ]; then
  printf 'format: `%s` changes these partly staged files, so the commit would not be formatted; stage each whole or not at all, then commit again:\n' "$command" >&2
  shown "$partly"
  exit 1
fi

whole=$(picked "$staged" whole)
[ -z "$whole" ] || unescaped '%s\\000' "$whole" | git --literal-pathspecs add --pathspec-from-file=- --pathspec-file-nul

unstaged=$(picked "$after" unstaged)
if [ -n "$unstaged" ]; then
  printf 'format: `%s` also changed these files the commit leaves out; they stay in the worktree:\n' "$command" >&2
  shown "$unstaged"
fi
