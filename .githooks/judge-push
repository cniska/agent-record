#!/bin/sh
# agent-gate:githooks:5
set -eu

workflows=''
export workflows

hooks=$(dirname "$0")
message=$(mktemp)
trap 'rm -f "$message"' EXIT

judge_subjects() {
  if git cat-file -e "$1^{commit}" 2>/dev/null; then range="$1..$2"; else range=$2; fi
  shas=$(git rev-list --no-merges "$range")
  for sha in $shas; do
    git log -1 --format=%B "$sha" > "$message"
    case "$(head -n 1 "$message")" in
      "fixup! "* | "squash! "* | "amend! "*) echo "$sha is an autosquash commit left in the range; squash it into the commit it names." >&2; exit 1 ;;
    esac
    sh "$hooks/commit-msg" "$message"
  done
}

judge_scan() {
  if ! command -v node >/dev/null 2>&1; then
    echo "$1: node is not on PATH, so $2 cannot be judged; install Node.js" >&2
    exit 3
  fi
  if [ "$report" = github ]; then
    node "$hooks/$1/scan.cjs" --format github "$3" "$4"
  else
    node "$hooks/$1/scan.cjs" "$3" "$4"
  fi
}

judge() {
  base=$2
  if ! git cat-file -e "$base^{commit}" 2>/dev/null && [ -n "$5" ] && [ "$4" != "refs/heads/${5#*/}" ]; then
    base=$5
  fi
  case "$1" in
    commit-subject) judge_subjects "$base" "$3" ;;
    no-comments) judge_scan no-comments "the push's comments" "$base" "$3" ;;
    no-secrets) judge_scan no-secrets "the push's secrets" "$base" "$3" ;;
    pinned-actions) judge_scan pinned-actions "the push's actions" "$base" "$3" ;;
    *) echo "judge-push: $1 is no gate that judges a push; name commit-subject, no-comments, no-secrets or pinned-actions" >&2; exit 2 ;;
  esac
}

judge_pushed_refs() {
  default=$(git symbolic-ref -q --short "refs/remotes/$2/HEAD" || true)
  while read -r _ local_sha remote_ref remote_sha; do
    case "$local_sha" in
      *[!0]*) judge "$1" "$remote_sha" "$local_sha" "$remote_ref" "$default" < /dev/null ;;
    esac
  done
}

case $# in
  2)
    report=text
    judge_pushed_refs "$1" "$2"
    ;;
  5)
    report=github
    judge "$@"
    ;;
  *)
    echo "judge-push takes a gate and git's remote, with the pushed refs on stdin, or a gate, a base, a head, the pushed ref and the remote's default branch" >&2
    exit 2
    ;;
esac
