{
  "name": "agent-record",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-record": "./bin/agent-record"
  },
  "scripts": {
    "agent-record": "bun run src/cli.ts",
    "format": "oxfmt 'src/**/*.ts' 'acceptance/**/*.ts' 'scripts/**/*.ts'",
    "lint": "oxlint --type-aware --deny-warnings src acceptance scripts && oxfmt --check 'src/**/*.ts' 'acceptance/**/*.ts' 'scripts/**/*.ts' && actionlint",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "acceptance": "bun test --timeout 20000 ./acceptance/*.acceptance.ts",
    "search-recall": "bun run scripts/search-recall.ts",
    "knip": "bunx --bun knip",
    "check": "bun run lint && bun run typecheck && bun run knip && bun test",
    "prepare": "! git rev-parse --git-dir >/dev/null 2>&1 || git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@babel/types": "^7.29.8",
    "@types/bun": "^1.4.2",
    "knip": "6.39.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@toon-format/toon": "4.4.0",
    "zod": "^4.6.5"
  }
}
